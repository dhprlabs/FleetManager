<?xml version='1.0'?>

<robot name="mogi_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- ROBOT NAMESPACE -->
  <!-- ========================================================= -->

  <xacro:arg name="robot_name" default="robot1"/>

  <xacro:property name="robot_name" value="$(arg robot_name)"/>


  <!-- ========================================================= -->
  <!-- GAZEBO + MATERIALS -->
  <!-- ========================================================= -->

  <xacro:include filename="$(find virtual_lab)/urdf/mogi_bot.gazebo" />

  <xacro:include filename="$(find virtual_lab)/urdf/materials.xacro" />


  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT -->
  <!-- ========================================================= -->

  <link name="${robot_name}/base_footprint"/>


  <!-- ========================================================= -->
  <!-- BASE LINK -->
  <!-- ========================================================= -->

  <joint name="${robot_name}/base_footprint_joint" type="fixed">

    <origin xyz="0 0 0" rpy="0 0 0"/>

    <parent link="${robot_name}/base_footprint"/>

    <child link="${robot_name}/base_link"/>

  </joint>


  <link name="${robot_name}/base_link">

    <pose>0 0 0.1 0 0 0</pose>

    <inertial>

      <mass value="15.0"/>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <inertia
        ixx="0.0625"
        ixy="0"
        ixz="0"
        iyy="0.2125"
        iyz="0"
        izz="0.25"/>

    </inertial>


    <collision name="collision">

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>

        <box size=".4 .2 .1"/>

      </geometry>

    </collision>


    <visual name="base_link_visual">

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>

        <mesh filename="package://virtual_lab/meshes/mogi_bot.dae"/>

      </geometry>

    </visual>


    <!-- Rear caster -->

    <collision name="rear_caster_collision">

      <origin xyz="-0.15 0 -0.05" rpy="0 0 0"/>

      <geometry>

        <sphere radius="0.0499"/>

      </geometry>

    </collision>


    <visual name="rear_caster_visual">

      <origin xyz="-0.15 0 -0.05" rpy="0 0 0"/>

      <geometry>

        <sphere radius="0.05"/>

      </geometry>

    </visual>


    <!-- Front caster -->

    <collision name="front_caster_collision">

      <origin xyz="0.15 0 -0.05" rpy="0 0 0"/>

      <geometry>

        <sphere radius="0.0499"/>

      </geometry>

    </collision>


    <visual name="front_caster_visual">

      <origin xyz="0.15 0 -0.05" rpy="0 0 0"/>

      <geometry>

        <sphere radius="0.05"/>

      </geometry>

    </visual>

  </link>


  <!-- ========================================================= -->
  <!-- LEFT WHEEL -->
  <!-- ========================================================= -->

  <joint
    type="continuous"
    name="${robot_name}/left_wheel_joint">

    <origin xyz="0 0.15 0" rpy="0 0 0"/>

    <child link="${robot_name}/left_wheel"/>

    <parent link="${robot_name}/base_link"/>

    <axis xyz="0 1 0"/>

    <limit effort="100" velocity="10"/>

    <dynamics damping="1.0" friction="1.0"/>

  </joint>


  <link name="${robot_name}/left_wheel">

    <inertial>

      <mass value="5.0"/>

      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>

      <inertia
        ixx="0.014"
        ixy="0"
        ixz="0"
        iyy="0.014"
        iyz="0"
        izz="0.025"/>

    </inertial>


    <collision>

      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>

      <geometry>

        <cylinder radius=".1" length=".05"/>

      </geometry>

    </collision>


    <visual name="left_wheel_visual">

      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>

      <geometry>

        <mesh filename="package://virtual_lab/meshes/wheel.dae"/>

      </geometry>

    </visual>

  </link>


  <!-- ========================================================= -->
  <!-- RIGHT WHEEL -->
  <!-- ========================================================= -->

  <joint
    type="continuous"
    name="${robot_name}/right_wheel_joint">

    <origin xyz="0 -0.15 0" rpy="0 0 0"/>

    <child link="${robot_name}/right_wheel"/>

    <parent link="${robot_name}/base_link"/>

    <axis xyz="0 1 0"/>

    <limit effort="100" velocity="10"/>

    <dynamics damping="1.0" friction="1.0"/>

  </joint>


  <link name="${robot_name}/right_wheel">

    <inertial>

      <mass value="5.0"/>

      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>

      <inertia
        ixx="0.014"
        ixy="0"
        ixz="0"
        iyy="0.014"
        iyz="0"
        izz="0.025"/>

    </inertial>


    <collision>

      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>

      <geometry>

        <cylinder radius=".1" length=".05"/>

      </geometry>

    </collision>


    <visual name="right_wheel_visual">

      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>

      <geometry>

        <mesh filename="package://virtual_lab/meshes/wheel.dae"/>

      </geometry>

    </visual>

  </link>


  <!-- ========================================================= -->
  <!-- WHEEL FRICTION -->
  <!-- ========================================================= -->

  <gazebo reference="${robot_name}/left_wheel">

    <mu1>0.2</mu1>
    <mu2>0.2</mu2>

    <kp>1000000.0</kp>
    <kd>100.0</kd>

    <minDepth>0.0001</minDepth>
    <maxVel>1.0</maxVel>

  </gazebo>


  <gazebo reference="${robot_name}/right_wheel">

    <mu1>0.2</mu1>
    <mu2>0.2</mu2>

    <kp>1000000.0</kp>
    <kd>100.0</kd>

    <minDepth>0.0001</minDepth>
    <maxVel>1.0</maxVel>

  </gazebo>


  <gazebo reference="${robot_name}/base_link">

    <mu1>0.000002</mu1>
    <mu2>0.000002</mu2>

  </gazebo>


  <!-- ========================================================= -->
  <!-- IMU -->
  <!-- ========================================================= -->

  <joint
    name="${robot_name}/imu_joint"
    type="fixed">

    <origin xyz="0 0 0" rpy="0 0 0"/>

    <parent link="${robot_name}/base_link"/>

    <child link="${robot_name}/imu_link"/>

  </joint>


  <link name="${robot_name}/imu_link"/>


  <!-- ========================================================= -->
  <!-- LIDAR -->
  <!-- ========================================================= -->

  <joint
    type="fixed"
    name="${robot_name}/scan_joint">

    <origin xyz="0 0 0.15" rpy="0 0 0"/>

    <child link="${robot_name}/lidar_link"/>

    <parent link="${robot_name}/base_link"/>

    <axis xyz="0 1 0"/>

  </joint>


  <link name="${robot_name}/lidar_link">

    <inertial>

      <mass value="1e-5"/>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <inertia
        ixx="1e-6"
        ixy="0"
        ixz="0"
        iyy="1e-6"
        iyz="0"
        izz="1e-6"/>

    </inertial>


    <collision name="collision">

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>

        <box size=".1 .1 .1"/>

      </geometry>

    </collision>


    <visual name="scan_link_visual">

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>

        <mesh filename="package://virtual_lab/meshes/lidar.dae"/>

      </geometry>

    </visual>

  </link>


  <!-- ========================================================= -->
  <!-- LIDAR GAZEBO SETTINGS -->
  <!-- ========================================================= -->

  <gazebo reference="${robot_name}/lidar_link">

    <selfCollide>false</selfCollide>

    <mu1 value="0.05"/>
    <mu2 value="0.05"/>

  </gazebo>

</robot>
